# Optional AI providers for the final intelligence snapshot
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Required to call POST /api/refresh or POST /api/cache/clear
ADMIN_API_KEY=replace-with-a-long-random-value

# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173

# Optional; required only for FRED-backed pipeline refreshes
FRED_API_KEY=
